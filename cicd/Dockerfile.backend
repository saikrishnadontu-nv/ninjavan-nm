# Backend image for Substrait: serves the static page and GET /health on port 8000.
# Built from the repo root, so COPY paths are repo-relative.
FROM python:3.12-slim
# Apply outstanding distro security updates (the platform scans this image).
RUN apt-get update \
 && apt-get upgrade -y \
 && rm -rf /var/lib/apt/lists/*
ENV PYTHONUNBUFFERED=1
WORKDIR /app
COPY backend/ .
EXPOSE 8000
USER nobody
CMD ["python", "server.py"]
